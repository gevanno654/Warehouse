# Environment configuration template.
# Copy this file to `.env` and replace the placeholder values.
# All values below are development placeholders. Never commit a real secret.

NODE_ENV=development
PORT=3000

# Container-to-container connection string used by the `api` Compose service.
# The hostname is the Compose service name, `db`.
DATABASE_URL=postgresql://app:app_password@db:5432/warehouse
# Host connection string used when the API runs directly on the host machine.
DATABASE_URL_HOST=postgresql://app:app_password@localhost:5432/warehouse
# Dedicated test database. Automated tests fail if this is unset; it never
# falls back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://app:app_password@localhost:5432/warehouse_test

# Credentials consumed by the `db` Compose service to initialise PostgreSQL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=warehouse

# Authentication secrets. Replace with a long random value in any real deployment.
# JWT_SECRET is mandatory and must be at least 16 characters; the API refuses to
# start without it. `docker compose` reads this value, so it cannot be omitted.
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime: a positive integer followed by s, m, h, or d.
JWT_EXPIRES_IN=1h
# bcrypt work factor. Minimum 10.
BCRYPT_ROUNDS=12

# Browser origin the API accepts requests from. Host port of the `web` service.
CORS_ORIGIN=http://localhost:5173
# Base URL the browser uses to reach the API. Read by Vite at build time.
VITE_API_BASE_URL=http://localhost:3000

# Development-only seed account password. Never reuse in production.
SEED_PASSWORD=development-only-password
