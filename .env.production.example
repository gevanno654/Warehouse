# Production environment template — placeholders only.
# Administrator creates `.env.production` on the VPS from this file.
# Never commit `.env.production` or any real secret.
# Never reuse development credentials.
#
# Usage (Phase 6.2C only, after approval):
#   cp .env.production.example .env.production
#   # edit .env.production on the VPS with real secrets, then:
#   docker compose -f compose.production.yml --env-file .env.production config

# ---- Fixed production values (do not change without review) ----
NODE_ENV=production
PORT=3000
POSTGRES_USER=warehouse_app
POSTGRES_DB=warehouse_production
CORS_ORIGIN=https://warehouse.gelabs.net
VITE_API_BASE_URL=https://warehouse.gelabs.net
JWT_EXPIRES_IN=1h

# ---- Secrets to be filled by the administrator on the VPS ----
# DATABASE_URL uses the internal Compose service name `db`, never localhost.
# Format: postgresql://warehouse_app:<POSTGRES_PASSWORD>@db:5432/warehouse_production
DATABASE_URL=postgresql://warehouse_app:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/warehouse_production

# PostgreSQL password for `warehouse_app`. Must match the password in DATABASE_URL.
# Generate on the VPS, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# JWT signing key. Backend requires >= 16 characters (`backend/src/config/env.ts`).
# Use a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET_MIN_16_CHARS

# ---- Explicitly NOT used in production runtime ----
# DATABASE_URL_HOST: host-only dev connection string. Do not set in production.
# TEST_DATABASE_URL: automated-test database. Do not set in production Compose.
# BCRYPT_ROUNDS: optional (default 12, min 10). Only needed for seed tooling.
# SEED_PASSWORD: development seed only. Do not set in production.
# ALLOW_PROD_SEED: never set to true in production; demo seed is refused otherwise.
