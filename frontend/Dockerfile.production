# Production frontend image.
# Build from the repository root:
#   docker build -f frontend/Dockerfile.production --build-arg VITE_API_BASE_URL=https://warehouse.gelabs.net .
#
# Differences from frontend/Dockerfile (development):
# - Uses frontend/nginx.production.conf, which proxies /api/, /health, /ready,
#   /openapi.yaml and /docs to the backend service via the internal network.
# - Requires VITE_API_BASE_URL build-arg (no localhost fallback at runtime;
#   the Dockerfile default below is only a build default — Compose requires
#   the production value explicitly).

# ---- Build stage ----
FROM node:24-alpine AS build
WORKDIR /app

# Vite inlines VITE_API_BASE_URL at build time, so it is a build argument, not
# a runtime environment variable. Changing it requires rebuilding this image.
ARG VITE_API_BASE_URL=https://warehouse.gelabs.net
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/tsconfig.json frontend/vite.config.ts frontend/vitest.setup.ts frontend/index.html ./
COPY frontend/src ./src

RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.29-alpine AS runtime
COPY frontend/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
