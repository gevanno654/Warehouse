```mermaid
flowchart TD
    U["User: Operator / Supervisor"]
    FE["Frontend React + TypeScript"]
    AUTH["Authentication Middleware<br/>JWT Verification"]
    RBAC["Authorization Middleware<br/>Role Check"]
    API["Express REST API"]
    VAL["Request Validation<br/>Zod"]
    SVC["Business Logic Service"]
    DB[("PostgreSQL")]
    RESP["API Response"]
    UI["Display Result in UI"]

    U --> FE
    FE -->|"HTTP Request + JWT"| AUTH
    AUTH -->|"Token valid"| RBAC
    AUTH -->|"Token invalid / expired"| RESP
    RBAC -->|"Role permitted"| API
    RBAC -->|"Role not permitted"| RESP
    API --> VAL
    VAL -->|"Invalid request"| RESP
    VAL -->|"Valid request"| SVC
    SVC <--> DB
    SVC --> RESP
    RESP -->|"JSON + HTTP status"| FE
    FE --> UI

    subgraph RECEIPT["Receipt Processing: Atomic Transaction"]
        R1["Receive quantity + Idempotency-Key"]
        R2["Validate receiving item and quantity"]
        R3["Begin database transaction"]
        R4["Lock relevant rows"]
        R5{"Idempotency key already exists?"}
        R6{"Request hash matches?"}
        R7["Return stored response snapshot"]
        R8["Reject key reuse with different payload"]
        R9{"Quantity exceeds remaining amount?"}
        R10["Reject over-receiving"]
        R11["Insert receipt operation"]
        R12["Increase received quantity"]
        R13["Increase inventory quantity"]
        R14["Insert inventory transaction"]
        R15["Recalculate document status"]
        R16["Store response snapshot"]
        R17["Commit transaction"]
        R18["Rollback transaction on failure"]

        R1 --> R2
        R2 --> R3
        R3 --> R4
        R4 --> R5
        R5 -->|"Yes"| R6
        R6 -->|"Yes"| R7
        R6 -->|"No"| R8
        R5 -->|"No"| R9
        R9 -->|"Yes"| R10
        R9 -->|"No"| R11
        R11 --> R12
        R12 --> R13
        R13 --> R14
        R14 --> R15
        R15 --> R16
        R16 --> R17
        R3 -.->|"Database / processing error"| R18
    end

    SVC -->|"Receipt request"| R1
    R7 -->|"Idempotent replay"| RESP
    R8 -->|"Conflict response"| RESP
    R10 -->|"Business validation error"| RESP
    R17 -->|"Successful receipt"| RESP
    R18 -->|"Failure response"| RESP

    classDef user fill:#e8f0fe,stroke:#4285f4,color:#202124
    classDef process fill:#e6f4ea,stroke:#34a853,color:#202124
    classDef database fill:#fef7e0,stroke:#f9ab00,color:#202124
    classDef error fill:#fce8e6,stroke:#ea4335,color:#202124

    class U,FE,UI user
    class AUTH,RBAC,API,VAL,SVC,RESP process
    class DB database
    class R8,R10,R18 error
```